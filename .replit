modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start backend"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 2>/dev/null; sleep 2; cd dashboard && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 3001/tcp 2>/dev/null; sleep 2; cd backend && npm run dev"
waitForPort = 3001

[[ports]]
localPort = 3001
externalPort = 3000

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm --prefix dashboard run build && npm --prefix backend install --omit=dev && npm --prefix backend run build"]
run = ["node", "backend/dist/server.js"]
publicDir = "dashboard/dist"

[userenv]

[userenv.shared]
JWT_SECRET = "666e2e2804d0611c79a4627fbace3a85eaf01bc205daaff2de982461662e69296c242697bdffa60fdde917a3ae5b2e56"
